# Frontend public environment variables
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Vercel (Project → Settings → Environment Variables):
# NEXT_PUBLIC_API_URL=https://YOUR_API_HOST/api/v1
# NEXT_PUBLIC_WS_URL=wss://YOUR_API_HOST/api/v1/ws
# Also set Root Directory to "frontend" in Vercel project settings.

# Supabase (optional — only if used)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
