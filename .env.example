# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Project Management Platform"
API_V1_STR="/api/v1"

# Security / JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=supersecret_jwt_key_for_development_change_in_production_123456789
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=project_management
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/project_management

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# CORS Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
